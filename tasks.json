{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Portfolio: Start video server (no terminal window)",
            "type": "process",
            "command": "node",
            "args": [
                "serve-portfolio.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": false,
                "focus": false,
                "panel": "dedicated",
                "reveal": "never",
                "showReuseMessage": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
